generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  password     String
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  refreshToken String?  @map("refresh_token")
  slug         String   @unique
  defaultCep   String?  @map("default_cep")

  cart         Cart?
  favorites    Favorite[]
  order        Order[]
  products     Product[]
  profilePic   ProfilePhoto?
  wallet       Wallet?
  reviews      Review[]
  couponUsages CouponUsage[]

  @@map("users")
}

model ProfilePhoto {
  id     String @id @default(cuid())
  url    String
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

model ProductPhoto {
  id        String  @id @default(cuid())
  url       String
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_photos")
}

model Genre {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[] @relation("GenreToProduct")

  @@index([name])
  @@map("genres")
}

model MediaType {
  id      Int       @id @default(autoincrement())
  name    TypeMidia @unique
  product Product[]

  @@map("media_types")
}

model Product {
  id                   String         @id @default(cuid())
  price                Decimal        @db.Decimal(5, 2)
  name                 String
  description          String
  amount               Int
  rating               Decimal?       @default(0.0) @db.Decimal(2, 1)
  mediaTypeId          Int            @map("media_type_id")
  city                 String?
  state                String?
  cep                  String         @default("11665-310")
  discountEnd          DateTime?      @map("discount_end")
  discountPrice        Decimal?       @map("discount_price") @db.Decimal(5, 2)
  discountStart        DateTime?      @map("discount_start")
  shippingCost         Decimal?       @map("shipping_cost") @db.Decimal(5, 2)
  viewCount            Int            @default(0) @map("view_count")
  freeInstallments     Int?           @default(1) @map("free_intalments")
  maxInstallments      Int?           @default(1) @map("max_intallments")
  minInstallmentAmount Decimal?       @map("min_intallment_amount") @db.Decimal(6, 2)
  monthlyInterestRate  Decimal?       @map("monthly_interest_rate") @db.Decimal(5, 4)
  sellerId             String         @map("seller_id")
  isActive             Boolean        @default(true) @map("is_active")
  slug                 String         @unique
  cartItems            CartItem[]
  orderItems           OrderItem[]
  photos               ProductPhoto[]
  view                 ProductView[]
  mediaType            MediaType      @relation(fields: [mediaTypeId], references: [id])
  seller               User           @relation(fields: [sellerId], references: [id])
  genre                Genre[]        @relation("GenreToProduct")
  favoritedBy          Favorite[]
  reviews              Review[]

  @@index([name])
  @@index([mediaTypeId])
  @@index([price])
  @@index([discountEnd])
  @@index([rating])
  @@index([viewCount])
  @@map("products")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

model ProductView {
  id        String   @id @default(cuid())
  viewAt    DateTime @default(now()) @map("view_at")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([viewAt])
  @@map("product_views")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  cartItem  CartItem[]
  user      User       @relation(fields: [userId], references: [id])

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  amount    Int
  price     Decimal @db.Decimal(8, 2)
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Wallet {
  id                 String              @id @default(uuid())
  balance            Decimal             @default(0) @db.Decimal(10, 2)
  userId             String              @unique @map("user_id")
  walletTransactions WalletTransaction[]
  user               User                @relation(fields: [userId], references: [id])
  walletTopUps     WalletTopUp[]

  @@map("wallets")
}

model WalletTopUp {
  id     String                @id @default(cuid())
  amount Decimal               @db.Decimal(10, 2)
  type   TypeWalletTransaction

  walletId    String @map("wallet_id")
  paymentId   Int?   @unique @map("payment_id")

  wallet      Wallet   @relation(fields: [walletId], references: [id])
  payment     Payment? @relation(fields: [paymentId], references: [id])

  createdAt        DateTime  @default(now()) @map("created_at")
  confirmedAt      DateTime? @map("confirmed_at")
  confimationToken String?   @unique @map("confirmation_token")
  tokenExpiredAt   DateTime? @map("token_expired_at")

  @@map("wallet_payments")
}

model WalletTransaction {
  id          String                @id @default(cuid())
  amount      Decimal               @db.Decimal(10, 2)
  type        TypeWalletTransaction
  description String                @default("")
  createdAt   DateTime              @default(now()) @map("created_at")
  walletId    String                @map("wallet_id")
  paymentId   Int?                  @unique @map("payment_id")
  wallet      Wallet                @relation(fields: [walletId], references: [id])
  payment     Payment?              @relation(fields: [paymentId], references: [id])

  @@map("wallet_transactions")
}

model Order {
  id           String       @id @default(cuid())
  status       OrderStatus  @default(PENDING)
  totalAmount  Decimal      @map("total_amount") @db.Decimal(5, 2)
  orderDate    DateTime     @default(now()) @map("order_date")
  address      String
  userId       String       @map("user_id")
  orderItems   OrderItem[]
  couponUsages CouponUsage?
  user         User         @relation(fields: [userId], references: [id])
  payment      Payment?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  amount    Int
  price     Decimal @db.Decimal(5, 2)
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id                 Int                 @id @default(autoincrement())
  paidAt             DateTime?           @map("paid_at")
  status             PaymentStatus       @default(PENDING)
  paymentMethod      PaymentMethod?      @map("payment_method")
  installments       Int?
  confirmationCode   String?             @unique @map("confirmation_code")
  tokenExpiresAt     DateTime?           @map("token_expires_at")

  orderId            String?             @unique @map("order_id")
  order              Order?               @relation(fields: [orderId], references: [id])

  walletTopUpId      String?             @unique @map("wallet_top_up_id")
  walletTopUp        WalletTopUp?

  walletTransactionId      String?             @unique @map("wallet_transaction_id")
  walletTransaction        WalletTransaction?

  @@map("payments")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Coupon {
  id    String     @id @default(uuid())
  code  String     @unique
  type  CouponType
  value Decimal    @db.Decimal(5, 2)

  maxUses   Int       @default(0) @map("max_uses")
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usages CouponUsage[]
}

model CouponUsage {
  id     String   @id @default(cuid())
  usedAt DateTime @default(now()) @map("used_at")

  userId   String @map("user_id")
  couponId String @map("coupon_id")
  orderId  String @unique @map("order_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId, orderId])
  @@map("coupon_usages")
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum Role {
  ADMIN  @map("admin")
  SELLER @map("seller")
  USER   @map("user")
}

enum TypeMidia {
  MOVIE @map("movie")
  GAME  @map("game")
}

enum OrderStatus {
  PENDING   @map("pending")
  PAID      @map("paid")
  SHIPPED   @map("shipped")
  DELIVERED @map("delivered")
  CANCELED  @map("canceled")
}

enum TypeWalletTransaction {
  DEPOSIT    @map("deposit")
  WITHDRAWAL @map("withdrawal")
}

enum PaymentMethod {
  PIX         @map("pix")
  BOLETO      @map("boleto")
  DEBIT_CARD  @map("debit_card")
  CREDIT_CARD @map("credit_card")
  WALLET      @map("wallet")
}

enum PaymentStatus {
  PENDING    @map("pending")
  AUTHORIZED @map("authorized")
  CAPTURED   @map("captured")
  FAILED     @map("failed")
  REFUNDED   @map("refunded")
}
