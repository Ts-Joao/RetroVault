# ------------------------------------------
# Banco de Dados
# ------------------------------------------
DATABASE_URL="postgresql://usuario:senha@localhost:5432/retrovault_db"
DATABASE_URL_TEST="postgresql://usuario:senha@localhost:5433/retrovault_db_test"

# ------------------------------------------
# JWT
# ------------------------------------------
JWT_ACCESS_SECRET=troque_por_uma_chave_segura
JWT_REFRESH_SECRET=troque_por_outra_chave_segura
JWT_TOKEN_AUDIENCE=retrovault-client
JWT_TOKEN_ISSUER=retrovault-api
JWT_TTL=3600

# ------------------------------------------
# Frontends (CORS)
# ------------------------------------------
WEB_URL="http://localhost:3000"
MOBILE_URL="http://localhost:8081"
ADMIN_URL="http://localhost:5000"

# ------------------------------------------
# SMTP / E-mail (Nodemailer)
# Para Gmail, use uma App Password:
# https://myaccount.google.com/apppasswords
# ------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false

MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua_app_password

MAIL_FROM="RetroVault <seu-email@gmail.com>"
